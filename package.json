{
	"name": "isitsafetoswim",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"dev": "vite dev",
		"build": "node ./scripts/build-location-index.mjs && node ./scripts/generate-images.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"data:index": "node ./scripts/build-location-index.mjs",
		"data:images": "node ./scripts/generate-images.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.1",
		"@vercel/analytics": "^2.0.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.56.0",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.7"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
