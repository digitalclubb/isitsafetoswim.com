{
	"name": "isitsafetoswim",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"dev": "vite dev",
		"build": "node ./scripts/build-location-index.mjs && node ./scripts/generate-images.mjs && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"data:index": "node ./scripts/build-location-index.mjs",
		"data:spills": "node ./scripts/build-spill-history.mjs",
		"data:images": "node ./scripts/generate-images.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^25.9.9",
		"@vercel/analytics": "^2.0.1",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.12"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@protomaps/basemaps": "^5.7.2",
		"maplibre-gl": "^5.24.1",
		"pmtiles": "^4.5.0",
		"redis": "^6.3.1"
	}
}
